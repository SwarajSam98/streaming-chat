# Copy this file to .env, then adjust as needed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=qwen2.5:0.5b
DEFAULT_TEMPERATURE=0.7
DEFAULT_SYSTEM_PROMPT=You are a concise, helpful assistant.
DATABASE_PATH=./data/chat.db
MAX_HISTORY_MESSAGES=20
CONNECT_TIMEOUT_SECONDS=5
READ_TIMEOUT_SECONDS=60
TOTAL_TIMEOUT_SECONDS=150
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=0.5
# Ollama is local, so monetary API pricing defaults to $0.
# Override these for a provider with published per-million-token rates.
INPUT_COST_PER_MILLION_USD=0
OUTPUT_COST_PER_MILLION_USD=0
